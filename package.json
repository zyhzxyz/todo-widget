{
  "name": "todo-widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:bundle": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server:start": "npm start --workspace @todo-widget/server",
    "server:dev": "npm run dev --workspace @todo-widget/server",
    "server:backup": "node server/src/backup.ts",
    "typecheck:server": "npm run typecheck --workspace @todo-widget/server",
    "test:server": "vitest run --config server/vitest.config.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test:plugin": "python3 -m unittest discover -s tests/plugin -v",
    "package:plugin": "python3 tools/package_astrbot.py"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "server"
  ]
}
