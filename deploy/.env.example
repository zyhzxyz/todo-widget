# Generate deploy/.env with: python3 tools/init_server_env.py
# These must be independent random secrets. Empty values intentionally refuse startup.
TODO_APP_TOKEN=
TODO_BOT_TOKEN=
TODO_TIMEZONE=Asia/Shanghai
# Add your HTTPS web origin if serving the optional browser UI. Never use '*'.
TODO_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
